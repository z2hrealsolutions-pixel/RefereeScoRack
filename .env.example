# Set these as Environment Variables in the Vercel project settings.
# Find both in Supabase: Project Settings -> API. Use the same project
# as the admin console, and the anon/public key ONLY. Never put the
# service role key in this app, it runs on referees' phones.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
